{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/category/**",
              "components/core/**",
              "components/forms/**",
              "components/guide/**",
              "components/media/**",
              "components/navigation/**",
              "components/overlay/**",
              "components/player/**",
              "ui_kits/are-tv/**",
              "ui_kits/are-tv/screens/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|Manrope|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, Manrope, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|glow|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, glow."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:live|new|quality|catchup|smart|neutral)$/]",
        "message": "<Badge> tone must be one of 'live' | 'new' | 'quality' | 'catchup' | 'smart' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|trailingIcon|full|disabled|focused|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, trailingIcon, full, disabled, focused."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|count|kind|posters|unit|smart|compact|width|focused|onClick|key|ref|className|style|children)$/]",
        "message": "<CategoryCard> doesn't accept that prop. Declared props: name, count, kind, posters, unit, smart, compact, width, focused, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryCard'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:live|tv|movies|series|guide|catchup|favorites|default)$/]",
        "message": "<CategoryCard> kind must be one of 'live' | 'tv' | 'movies' | 'series' | 'guide' | 'catchup' | 'favorites' | 'default'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|count|kind|unit|smart|active|focused|onClick|key|ref|className|style|children)$/]",
        "message": "<CategoryRow> doesn't accept that prop. Declared props: name, count, kind, unit, smart, active, focused, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryRow'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:live|tv|movies|series|guide|catchup|favorites|default)$/]",
        "message": "<CategoryRow> kind must be one of 'live' | 'tv' | 'movies' | 'series' | 'guide' | 'catchup' | 'favorites' | 'default'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChannelTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:channel|number|logo|now|next|progress|health|quality|codec|catchup|fav|width|focused|onClick|key|ref|className|style|children)$/]",
        "message": "<ChannelTile> doesn't accept that prop. Declared props: channel, number, logo, now, next, progress, health, quality, codec, catchup, fav, width, focused, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChannelTile'] > JSXAttribute[name.name='health'] > Literal[value!=/^(?:stable|moderate|poor)$/]",
        "message": "<ChannelTile> health must be one of 'stable' | 'moderate' | 'poor'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|selected|focused|icon|dot|size|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, selected, focused, icon, dot, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Chip> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContinueCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|image|progress|remaining|width|focused|onClick|key|ref|className|style|children)$/]",
        "message": "<ContinueCard> doesn't accept that prop. Declared props: title, meta, image, progress, remaining, width, focused, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|actions|width|onClose|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, children, actions, width, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='GuideCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|time|live|now|catchup|progress|focused|width|onClick|onFocusChange|key|ref|className|style|children)$/]",
        "message": "<GuideCell> doesn't accept that prop. Declared props: title, time, live, now, catchup, progress, focused, width, onClick, onFocusChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|kicker|meta|synopsis|image|badges|actions|height|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: title, kicker, meta, synopsis, image, badges, actions, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|variant|size|active|focused|disabled|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: children, label, variant, size, active, focused, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|glass|ghost)$/]",
        "message": "<IconButton> variant must be one of 'solid' | 'glass' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayerControls'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|live|playing|position|buffered|elapsed|total|channelLogoInitials|key|ref|className|style|children)$/]",
        "message": "<PlayerControls> doesn't accept that prop. Declared props: title, subtitle, live, playing, position, buffered, elapsed, total, channelLogoInitials."
      },
      {
        "selector": "JSXOpeningElement[name.name='PosterTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|image|badges|rating|progress|width|focused|onClick|key|ref|className|style|children)$/]",
        "message": "<PosterTile> doesn't accept that prop. Declared props: title, meta, image, badges, rating, progress, width, focused, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rail'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|smart|seeAll|children|key|ref|className|style|children)$/]",
        "message": "<Rail> doesn't accept that prop. Declared props: title, smart, seeAll, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: id, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|current|key|ref|className|style|children)$/]",
        "message": "<StepIndicator> doesn't accept that prop. Declared props: steps, current."
      },
      {
        "selector": "JSXOpeningElement[name.name='StreamHealth'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|label|bitrate|size|key|ref|className|style|children)$/]",
        "message": "<StreamHealth> doesn't accept that prop. Declared props: level, label, bitrate, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='StreamHealth'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:stable|moderate|poor)$/]",
        "message": "<StreamHealth> level must be one of 'stable' | 'moderate' | 'poor'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StreamHealth'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<StreamHealth> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|focused|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, disabled, focused."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|placeholder|mono|icon|helper|error|prefix|focused|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, value, placeholder, mono, icon, helper, error, prefix, focused."
      }
    ]
  },
