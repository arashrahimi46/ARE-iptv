<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Firebase Analytics (play-services-measurement) merges these three in transitively, which made
         the manifest declare an advertising identifier and forced a "yes" on Play's Advertising ID
         declaration. This app has no ads, no attribution and no monetisation, and the privacy policy
         states that usage events are not linked to your identity and that we do not build profiles
         or advertise to you. An advertising ID is exactly a cross-session advertising identifier, so
         shipping one would make that statement untrue. Removing it also keeps the Data safety form
         honest: there is no "Device or other IDs" to declare. Analytics still works; it only loses
         ad-based attribution, which was never used.

         ACCESS_ADSERVICES_ATTRIBUTION is the Privacy Sandbox Attribution Reporting API, not the
         advertising ID, so it never triggered Play's declaration error and survived the first two
         removals unnoticed. It is dropped for the same reason as the others: the sentence above says
         this app does no attribution, and shipping the permission that exists to perform attribution
         would contradict it. Nothing in the app calls the API. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- required="false", deliberately reversed from the TV-only stance this used to take.
         required="true" is what made Play treat this as a TV-exclusive listing, and that is
         precisely why closed-test users could not install it: their phones were filtered out of
         the track and the opt-in link looked broken.

         There is no longer anything to gain from TV-exclusivity, because the phone UI now ships in
         THIS app (:mobile is an android-library dexed into this AAB). A handset that installs it
         gets the touch-first phone Activity, never the D-pad TV one; see the launcher-category
         split on the two activities below, which is what actually routes per form factor.
         Declaring leanback at all (even optional) is still what qualifies the listing for the
         Android TV section of Play, so the TV banner and TV screenshots stay meaningful.
         touchscreen stays required="false" above: a TV has none. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name=".IptvApp"
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Iptv">

        <!-- Sentry crash/ANR reporting. The DSN is a public client ingest key (safe to ship in the
             APK by design). auto-init is off so IptvApp.onCreate can tag release/environment via
             SentryAndroid.init; the SDK still reads this DSN from here. -->
        <meta-data android:name="io.sentry.dsn"
            android:value="https://9bb62839f8142cbc73cb39fe4185ff4c@o298398.ingest.us.sentry.io/4511785384869888" />
        <meta-data android:name="io.sentry.auto-init" android:value="false" />

        <!-- The TV entry point. LEANBACK_LAUNCHER *only*: dropping LAUNCHER is load-bearing now
             that this AAB also installs on phones: with both categories a handset would show TWO
             icons for one app, and the second would open the D-pad TV UI, which is unusable without
             a remote. Phone/TV routing is entirely this category split; there is no runtime
             form-factor check deciding which Activity launches.
             Android TV and Google TV launchers surface LEANBACK_LAUNCHER, so the TV is unaffected. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Required by AndroidX per-app language APIs (AppCompatDelegate.setApplicationLocales)
             so the selected locale is auto-persisted and restored across process death/cold
             start on API < 33, where there is no framework-level per-app language storage. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>