<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- REQUIRED, not optional: this is what restricts the app to TV devices on Play.
         With required="false" Play treats :tv as phone-eligible, makes phone screenshots
         mandatory on the store listing, and would let it install on a handset, where a
         D-pad-only UI with no touch targets is unusable. The phone app is a separate
         listing (:mobile, applicationId com.areiptv.mobile), so there is nothing to gain
         from :tv being installable off-TV.
         touchscreen stays required="false" above: a TV has none. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <application
        android:name=".IptvApp"
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Iptv">

        <!-- Sentry crash/ANR reporting. The DSN is a public client ingest key (safe to ship in the
             APK by design). auto-init is off so IptvApp.onCreate can tag release/environment via
             SentryAndroid.init; the SDK still reads this DSN from here. -->
        <meta-data android:name="io.sentry.dsn"
            android:value="https://9bb62839f8142cbc73cb39fe4185ff4c@o298398.ingest.us.sentry.io/4511785384869888" />
        <meta-data android:name="io.sentry.auto-init" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Required by AndroidX per-app language APIs (AppCompatDelegate.setApplicationLocales)
             so the selected locale is auto-persisted and restored across process death/cold
             start on API < 33, where there is no framework-level per-app language storage. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>