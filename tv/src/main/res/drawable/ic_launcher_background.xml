<?xml version="1.0" encoding="utf-8"?>
<!-- Glass redesign V1: frosted-blue tile for the adaptive launcher icon — a blue→ink diagonal
     gradient with a soft top highlight, so the icon reads as the same glass material as the app. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0.0" android:color="#FF2E6BF0" />
                <item android:offset="0.55" android:color="#FF1D4ED8" />
                <item android:offset="1.0" android:color="#FF0B1220" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Lit top edge / inner highlight -->
    <path android:pathData="M0,0h108v54h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="0"
                android:endX="54" android:endY="54">
                <item android:offset="0.0" android:color="#40FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
