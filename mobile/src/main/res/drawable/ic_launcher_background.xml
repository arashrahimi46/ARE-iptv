<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive launcher tile: the deep-navy plate the brand mark is drawn against, sampled
     from the master icon render (#03143D top -> #010A28 bottom) with the same lit top edge.
     It is deliberately NOT the app's accent blue — the foreground glyph is bright #01A1FE, so a
     blue tile would leave the mark with almost no contrast. Kept as a vector: it is a flat
     gradient, so a bitmap would cost KBs for nothing. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="0"
                android:endX="54" android:endY="108">
                <item android:offset="0.0" android:color="#FF03143D" />
                <item android:offset="1.0" android:color="#FF010A28" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Lit top edge / inner highlight -->
    <path android:pathData="M0,0h108v54h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="0"
                android:endX="54" android:endY="54">
                <item android:offset="0.0" android:color="#1FFFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
