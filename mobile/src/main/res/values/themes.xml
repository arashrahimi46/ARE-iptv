<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all theming (AreIptvTheme); this is only the pre-Compose window background so
         there's no white/black flash before the first frame. -->
    <!-- Theme.AppCompat.DayNight (not the plain android:Theme.Material.* this used to be), required
         by AppCompatActivity, which MainActivity switched to so AppCompatDelegate.setApplicationLocales()
         actually takes effect (see MainActivity's onCreate comment; same fix :tv already needed). -->
    <style name="Theme.IptvMobile" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/background_light</item>
    </style>
</resources>
